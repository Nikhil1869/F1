# ── Flask ─────────────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-to-something-random

# ── LLM (AI Chat feature) ────────────────────────────────────────────────
# Provide your own API key for the chat endpoint
LLM_API_KEY=

# ── OpenF1 API ────────────────────────────────────────────────────────────
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TIMEOUT=10

# ── Data source preference ───────────────────────────────────────────────
# "auto"   = OpenF1 for schedule, FastF1 for telemetry (recommended)
# "fastf1" = always FastF1
# "openf1" = prefer OpenF1 where possible
DATA_SOURCE_PREFER=auto
