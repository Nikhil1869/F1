# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
*.so

# ── Virtual environments ─────────────────────────────────────────────────
venv/
.venv/
env/

# ── Environment secrets ──────────────────────────────────────────────────
.env

# ── Node / Frontend (global — catches any nesting depth) ─────────────────
node_modules/
.next/
.swc/

# ── FastF1 / data caches (large binary files — keep folders via .gitkeep)
fastf1_cache/*
!fastf1_cache/.gitkeep
precomputed/*
!precomputed/.gitkeep
cache/

# ── Temporary replay data ────────────────────────────────────────────────
tmp_f1_replay/

# ── SQLite databases ─────────────────────────────────────────────────────
*.db
*.sqlite

# ── Generated output (plots, images — regenerated by scripts) ────────────
output/

# ── IDE / editor ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Jupyter ──────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── AI assistant config (not project code) ───────────────────────────────
CLAUDE.md
AGENTS.md
